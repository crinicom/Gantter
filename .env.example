# Modo de persistencia: offline | drive | server
VITE_APP_MODE=offline

# (Modo drive) Credenciales Google Identity Services
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_APP_ID=

# (Modo drive) Velocidad de sync a Drive
VITE_SYNC_DEBOUNCE_MS=2000

# (Modo server) URL base de la API; vacío = mismo origen.
# En desarrollo con el proxy de Vite (/api -> :3001) puede dejarse vacío.
VITE_API_BASE=

# (Modo server) Chat de Maie (§11): clave de OpenAI para gpt-4o-mini (costo
# mínimo). Vive server-side (fly secrets / server/.env), nunca en el cliente.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# (Modo server, en el server/ dir o en el entorno de deploy)
# JWT_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GOOGLE_REDIRECT_URI
# PORT (3001 por defecto), DB_PATH