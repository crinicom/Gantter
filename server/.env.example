# Gantter server - variables de entorno (copia a .env y rellena)
# NUNCA commits secretos: .env esta en .gitignore.

# Puerto de la API
PORT=3001

# Secreto para firmar los JWT de sesion (obligatorio, aleatorio en produccion)
JWT_SECRET=

# Cliente OAuth de Google (consola de Google Cloud)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URI de redireccion registrada en el cliente OAuth (cambiar en produccion)
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
# Tras el callback de Google, aqui se redirige la SPA
APP_BASE_URL=http://localhost:5173

# Opcional: ruta del archivo SQLite (por defecto: server/data.sqlite)
# DATABASE_PATH=

# Opcional: claves del gateway multi-proveedor de Maia (§11). Si faltan todas,
# Maia degrada a respuestas templated (sin gasto). El proveedor activo se
# define en server/src/config/llm.config.json, sin tocar código.
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# MAIA_PROMPTS_DIR=
# LLM_CONFIG_PATH=
